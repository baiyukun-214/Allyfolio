// Cloudflare Workers static assets plus a small script that issues a permanent HTTPS redirect
// for HTTP requests. Custom domains allyfolio.com and www.allyfolio.com stay attached in the
// Cloudflare dashboard (Workers → allyfolio → Settings → Domains & Routes). No "routes" or
// "custom_domains" are declared here on purpose: declaring them makes `wrangler deploy` manage
// them and could detach the domains configured in the dashboard.
{
  "name": "allyfolio",
  "main": "./https-redirect.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
