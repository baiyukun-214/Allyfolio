---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { readingTime } from '../../lib/reading';
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={post.data.title} description={post.data.description} ogType="article">
  <article>
    <header class="border-b border-slate-200 bg-gradient-to-b from-brand-50 to-white">
      <div class="mx-auto max-w-3xl px-4 pt-12 pb-10">
        <p><a class="text-sm font-medium text-brand-700 underline underline-offset-4" href="/blog">← All posts</a></p>
        {post.data.tags.length > 0 && <ul class="mt-8 flex flex-wrap gap-2" aria-label="Tags">{post.data.tags.map((t) => <li class="rounded-full bg-white border border-brand-200 px-2.5 py-0.5 text-xs font-semibold text-brand-700">{t}</li>)}</ul>}
        <h1 class="mt-4 text-4xl md:text-5xl font-bold tracking-tight leading-tight text-ink">{post.data.title}</h1>
        <p class="mt-5 text-lg text-muted leading-relaxed">{post.data.description}</p>
        <p class="mt-6 flex items-center gap-3 text-sm text-muted">
          <span aria-hidden="true" class="grid h-9 w-9 place-items-center rounded-full bg-brand-700 text-xs font-semibold text-white">A</span>
          <span><span class="font-medium text-ink">{post.data.author}</span><br /><time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time> · {readingTime(post.body)} min read</span>
        </p>
      </div>
    </header>
    <div class="mx-auto max-w-3xl px-4 py-12 prose prose-slate prose-lg prose-headings:text-ink prose-headings:tracking-tight prose-h2:text-2xl prose-h2:mt-12 prose-a:text-brand-700 prose-strong:text-ink">
      <Content />
    </div>
    <aside aria-labelledby="post-cta" class="mx-auto max-w-3xl px-4 pb-16">
      <div class="rounded-2xl bg-brand-50 border border-brand-200 p-8 sm:flex sm:items-center sm:justify-between gap-6">
        <div>
          <h2 id="post-cta" class="text-xl font-semibold text-ink">Keep a record of your accessibility work</h2>
          <p class="mt-2 text-muted">Scheduled scans and a timestamped evidence trail. No overlay widget.</p>
        </div>
        <a href="/#waitlist" class="btn btn-primary mt-5 sm:mt-0 shrink-0">Join the waitlist</a>
      </div>
    </aside>
  </article>
</Base>
