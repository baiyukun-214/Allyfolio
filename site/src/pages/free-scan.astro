---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
const sample = [
  ['Serious', 'Form field has no label', 3, 'text-red-700 bg-red-50'],
  ['Serious', 'Text contrast below 4.5:1', 7, 'text-red-700 bg-red-50'],
  ['Moderate', 'Image without alt text', 2, 'text-amber-800 bg-amber-50'],
  ['Minor', 'Heading levels skipped', 1, 'text-muted bg-slate-100'],
];
---
<Base title="Free scan" description="Run a free automated accessibility check of one page with Allyfolio. Coming soon.">
  <PageHeader eyebrow="Free scan" title="Free accessibility scan" lead="Check one page of your website with axe-core and get a short summary of the issues automated testing can detect." />
  <div class="mx-auto max-w-6xl px-4 py-14 grid gap-10 lg:grid-cols-2">
    <div>
      <div class="rounded-2xl border border-slate-200 p-6 sm:p-8">
        <p class="inline-flex items-center gap-2 rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700">Coming soon</p>
        <p class="mt-3 text-muted" id="scan-soon">The free scan is not live yet. <a class="text-brand-700 underline" href="/#waitlist">Join the waitlist</a> to hear when it launches.</p>
        <!-- TODO: wire this form to the scan API (e.g. POST /api/scan) and enable the fields once it exists. -->
        <form class="mt-6 space-y-4" aria-describedby="scan-soon">
          <fieldset disabled class="space-y-4">
            <div>
              <label for="scan-url" class="block font-medium text-ink">Page URL</label>
              <p id="scan-url-hint" class="text-sm text-muted">For example https://www.example.com</p>
              <input id="scan-url" name="url" type="url" aria-describedby="scan-url-hint" autocomplete="url" class="mt-2 h-12 w-full cursor-not-allowed rounded-lg border border-slate-300 bg-slate-100 px-4 text-muted" />
            </div>
            <button type="submit" class="btn w-full sm:w-auto cursor-not-allowed bg-slate-200 text-muted">Scan page – coming soon</button>
          </fieldset>
        </form>
      </div>
      <p class="mt-6 text-sm text-muted leading-relaxed">Automated testing finds roughly 57% of issues (<a class="text-brand-700 underline" href="https://www.deque.com/automated-accessibility-testing-coverage/">Deque study</a>). A clean result does not mean your page is fully accessible – the rest needs manual review.</p>
    </div>
    <figure class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xl shadow-brand-900/5">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <figcaption class="font-semibold text-ink">Sample report <span class="font-normal text-muted">· www.example.com</span></figcaption>
        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-muted">Example data</span>
      </div>
      <dl class="mt-6 grid grid-cols-3 gap-3 text-center">
        <div class="rounded-xl bg-red-50 p-3"><dt class="text-xs text-red-700">Serious</dt><dd class="text-2xl font-bold text-red-700">10</dd></div>
        <div class="rounded-xl bg-amber-50 p-3"><dt class="text-xs text-amber-800">Moderate</dt><dd class="text-2xl font-bold text-amber-800">2</dd></div>
        <div class="rounded-xl bg-slate-100 p-3"><dt class="text-xs text-muted">Minor</dt><dd class="text-2xl font-bold text-ink">1</dd></div>
      </dl>
      <table class="mt-6 w-full text-sm">
        <caption class="sr-only">Example issues found</caption>
        <thead><tr class="text-left text-muted border-b border-slate-200"><th scope="col" class="py-2 font-medium">Issue</th><th scope="col" class="py-2 font-medium">Impact</th><th scope="col" class="py-2 font-medium text-right">Count</th></tr></thead>
        <tbody class="divide-y divide-slate-100">
          {sample.map(([imp, t, n, c]) => <tr><td class="py-3 pr-2 text-ink">{t}</td><td class="py-3"><span class={`rounded-md px-2 py-0.5 text-xs font-semibold ${c}`}>{imp}</span></td><td class="py-3 text-right text-ink">{n}</td></tr>)}
        </tbody>
      </table>
      <p class="mt-4 text-xs text-muted">Plus a checklist of items automated testing cannot check.</p>
    </figure>
  </div>
</Base>
