---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { API_BASE } from '../lib/api';
const sample = [
  ['Serious', 'Form field has no label', 3, 'text-red-700 bg-red-50'],
  ['Serious', 'Text contrast below 4.5:1', 7, 'text-red-700 bg-red-50'],
  ['Moderate', 'Image without alt text', 2, 'text-amber-800 bg-amber-50'],
  ['Minor', 'Heading levels skipped', 1, 'text-muted bg-slate-100'],
];
---
<Base title="Free scan" description="Run a free automated accessibility check of one page with Allyfolio, using axe-core in a real browser.">
  <PageHeader eyebrow="Free scan" title="Free accessibility scan" lead="Check one page of your website with axe-core and get a short summary of the issues automated testing can detect." />
  <div class="mx-auto max-w-6xl px-4 py-14 grid gap-10 lg:grid-cols-2 lg:items-start">
    <div>
      <div class="rounded-2xl border border-slate-200 p-6 sm:p-8">
        <form id="scan-form" class="space-y-4" data-api={API_BASE} novalidate>
          <div>
            <label for="scan-url" class="block font-medium text-ink">Page URL</label>
            <p id="scan-url-hint" class="text-sm text-muted">For example https://www.example.com – one public page, up to 5 scans per hour.</p>
            <input id="scan-url" name="url" type="url" inputmode="url" required aria-describedby="scan-url-hint scan-error" autocomplete="url" placeholder="https://" class="mt-2 h-12 w-full rounded-lg border border-slate-400 bg-white px-4 text-ink" />
          </div>
          <p id="scan-error" class="text-sm font-medium text-red-700 empty:hidden" role="alert"></p>
          <button id="scan-submit" type="submit" class="btn btn-primary w-full sm:w-auto disabled:opacity-70">Scan page</button>
        </form>
        <p id="scan-status" role="status" aria-live="polite" class="mt-4 text-sm text-muted empty:hidden"></p>
      </div>
      <p class="mt-6 text-sm text-muted leading-relaxed">Automated testing finds roughly 57% of issues (<a class="text-brand-700 underline" href="https://www.deque.com/automated-accessibility-testing-coverage/">Deque study</a>). A clean result does not mean your page is fully accessible – manual review by people is still needed.</p>
    </div>

    <section id="scan-result" aria-labelledby="result-heading" tabindex="-1" class="hidden rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xl shadow-brand-900/5 focus:outline-none">
      <h2 id="result-heading" class="text-xl font-semibold text-ink">Results</h2>
      <p id="result-url" class="mt-1 text-sm text-muted break-all"></p>
      <dl id="result-counts" class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3 text-center"></dl>
      <div id="result-groups" class="mt-6 space-y-6"></div>
      <p class="mt-6 rounded-xl border-l-4 border-brand-500 bg-brand-50 px-4 py-3 text-sm text-muted"><strong class="text-ink">Only part of the picture:</strong> automated testing finds roughly 57% of issues (Deque study). Manual review is still needed for things like meaningful alt text, focus order and understandable content.</p>
      <p class="mt-4 text-sm"><a class="font-semibold text-brand-700 underline underline-offset-4" href="/#waitlist">Join the waitlist for scheduled monitoring and an evidence trail →</a></p>
    </section>

    <figure id="sample-report" class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xl shadow-brand-900/5">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <figcaption class="font-semibold text-ink">Sample report <span class="font-normal text-muted">· www.example.com</span></figcaption>
        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-muted">Example data</span>
      </div>
      <table class="mt-6 w-full text-sm">
        <caption class="sr-only">Example issues found</caption>
        <thead><tr class="text-left text-muted border-b border-slate-200"><th scope="col" class="py-2 font-medium">Issue</th><th scope="col" class="py-2 font-medium">Impact</th><th scope="col" class="py-2 font-medium text-right">Count</th></tr></thead>
        <tbody class="divide-y divide-slate-100">
          {sample.map(([imp, t, n, c]) => <tr><td class="py-3 pr-2 text-ink">{t}</td><td class="py-3"><span class={`rounded-md px-2 py-0.5 text-xs font-semibold ${c}`}>{imp}</span></td><td class="py-3 text-right text-ink">{n}</td></tr>)}
        </tbody>
      </table>
    </figure>
  </div>
</Base>
<script>
  const form = document.getElementById('scan-form') as HTMLFormElement;
  const input = document.getElementById('scan-url') as HTMLInputElement;
  const btn = document.getElementById('scan-submit') as HTMLButtonElement;
  const err = document.getElementById('scan-error')!;
  const status = document.getElementById('scan-status')!;
  const result = document.getElementById('scan-result')!;
  const sample = document.getElementById('sample-report')!;
  const IMPACT: Record<string, [string, string]> = { critical: ['Critical', 'text-red-700 bg-red-50'], serious: ['Serious', 'text-red-700 bg-red-50'], moderate: ['Moderate', 'text-amber-800 bg-amber-50'], minor: ['Minor', 'text-muted bg-slate-100'] };
  const el = (tag: string, cls = '', text = '') => { const e = document.createElement(tag); if (cls) e.className = cls; if (text) e.textContent = text; return e; };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.textContent = ''; input.removeAttribute('aria-invalid');
    const url = input.value.trim();
    if (!url) { err.textContent = 'Please enter the address of a page.'; input.setAttribute('aria-invalid', 'true'); input.focus(); return; }
    btn.disabled = true; btn.textContent = 'Scanning…'; form.setAttribute('aria-busy', 'true');
    status.textContent = 'Scanning the page in a real browser. This usually takes 10 to 30 seconds.';
    try {
      const res = await fetch(`${form.dataset.api}/api/scan`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ url }) });
      const j = await res.json().catch(() => ({}));
      if (!res.ok) { status.textContent = ''; err.textContent = j.error ?? 'The scan failed. Please try again.'; input.setAttribute('aria-invalid', 'true'); input.focus(); return; }
      render(j);
      status.textContent = `Scan finished: ${j.total} issue${j.total === 1 ? '' : 's'} found by automated checks.`;
    } catch {
      status.textContent = ''; err.textContent = 'We could not reach the scan service. Please try again later.';
    } finally { btn.disabled = false; btn.textContent = 'Scan page'; form.removeAttribute('aria-busy'); }
  });

  function render(j: any) {
    document.getElementById('result-url')!.textContent = `${j.url} · scanned ${new Date(j.scannedAt).toLocaleString('en-GB')}`;
    const counts = document.getElementById('result-counts')!; counts.replaceChildren();
    for (const k of ['critical', 'serious', 'moderate', 'minor']) {
      const d = el('div', `rounded-xl p-3 ${IMPACT[k][1]}`); d.append(el('dt', 'text-xs', IMPACT[k][0]), el('dd', 'text-2xl font-bold', String(j.counts[k] ?? 0))); counts.append(d);
    }
    const groups = document.getElementById('result-groups')!; groups.replaceChildren();
    if (!j.total) groups.append(el('p', 'text-ink', 'No issues found by automated checks. That is a good start – but it does not mean the page is fully accessible.'));
    for (const g of j.byImpact) {
      if (!g.rules.length) continue;
      const sec = el('div'); sec.append(el('h3', 'font-semibold text-ink', `${IMPACT[g.impact][0]} (${g.count})`));
      const ul = el('ul', 'mt-2 divide-y divide-slate-100 text-sm');
      for (const r of g.rules) {
        const li = el('li', 'py-3');
        const a = el('a', 'font-medium text-brand-700 underline underline-offset-2', r.help) as HTMLAnchorElement; a.href = r.helpUrl; a.rel = 'noopener';
        const meta = el('p', 'mt-1 text-muted', `${r.count} element${r.count === 1 ? '' : 's'}${r.wcag.length ? ' · ' + r.wcag.join(', ') : ''}`);
        li.append(a, meta); ul.append(li);
      }
      sec.append(ul); groups.append(sec);
    }
    sample.classList.add('hidden'); result.classList.remove('hidden'); result.focus();
  }
</script>
