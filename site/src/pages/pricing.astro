---
import Base from '../layouts/Base.astro';
import Plans from '../components/Plans.astro';
import Faq from '../components/Faq.astro';
import Waitlist from '../components/Waitlist.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
const included = [
  ['Automated scans with Playwright and axe-core', 'check'],
  ['Manual review checklist for issues automation cannot detect', 'doc'],
  ['Timestamped history of scans and fixes', 'clock'],
  ['EU data hosting', 'globe'], // TODO: confirm hosting region/provider
  ['No overlay widget and no scripts on your site', 'ban'],
];
const faqs = [
  { q: 'Can I change plans later?', a: 'We plan to let you switch between plans at any time. Exact billing terms will be confirmed before launch.' /* TODO: confirm plan-change terms */ },
  { q: 'Are prices final?', a: 'Prices are in euros and exclude VAT. Plans and limits may change before launch; waitlist members will hear first and get a discounted first year.' },
  { q: 'What is the one-off report for?', a: 'For a single snapshot – for example before a relaunch. You get one automated scan, a PDF report and a draft accessibility statement, without a subscription.' },
  { q: 'Does a clean scan mean my site is accessible?', a: 'No. Automated testing finds roughly 57% of issues (Deque study). The rest needs manual review by people, which our checklist helps you plan.' },
];
---
<Base title="Pricing" description="Allyfolio pricing: Starter €19/month, Business €39/month, Agency €99/month, or a one-off accessibility report for €39.">
  <PageHeader eyebrow="Pricing" title="Plans for every size of site" lead="Pick the plan that fits your site. All prices are in euros and exclude VAT. Plans and limits may change before launch." />
  <div class="mx-auto max-w-6xl px-4 py-16">
    <section aria-labelledby="plans-heading" class="pt-4">
      <h2 id="plans-heading" class="sr-only">Plans</h2>
      <Plans detailed />
    </section>
    <section aria-labelledby="included-heading" class="mt-20 rounded-2xl border border-slate-200 p-8 md:p-10">
      <h2 id="included-heading" class="text-2xl font-bold tracking-tight text-ink">Included in every plan</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {included.map(([t, i]) => <li class="flex items-start gap-3 text-ink"><span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-700"><Icon name={i} /></span><span class="pt-1">{t}</span></li>)}
      </ul>
      <p class="mt-8 border-t border-slate-200 pt-6 text-sm text-muted">Allyfolio is a testing and documentation tool. It does not replace manual expert review or legal advice.</p>
    </section>
    <section aria-labelledby="pfaq-heading" class="mt-20 grid gap-10 lg:grid-cols-12">
      <h2 id="pfaq-heading" class="lg:col-span-4 text-2xl font-bold tracking-tight text-ink">Pricing questions</h2>
      <div class="lg:col-span-8"><Faq items={faqs} /></div>
    </section>
  </div>
  <Waitlist />
</Base>
