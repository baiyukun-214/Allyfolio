---
import Base from '../layouts/Base.astro';
import Plans from '../components/Plans.astro';
import Faq from '../components/Faq.astro';
import Waitlist from '../components/Waitlist.astro';
import Icon from '../components/Icon.astro';
import Tile from '../components/Tile.astro';
import Snippet from '../components/Snippet.astro';
import Timeline from '../components/Timeline.astro';
import Coverage from '../components/Coverage.astro';
import BrowserPins from '../components/BrowserPins.astro';
import Spot from '../components/Spot.astro';
import { i18n } from '../i18n';
const { t, l } = i18n(Astro.url.pathname);
const H = t.home;
const D = H.demo, F = H.fix, V = t.visuals;
const stepIcons = ['plus', 'radar', 'wrench', 'archive'];
const faqIcons = ['scale', 'ban', 'building', 'globe', 'radar', 'doc'];
const sevCls = ['bg-red-50 text-red-800', 'bg-red-50 text-red-800', 'bg-amber-50 text-amber-900', 'bg-brand-50 text-brand-700'];
const trailMeta = [
  { d: '2026-09-01', cls: 'text-red-700 bg-red-50', h: 100 },
  { d: '2026-09-08', cls: 'text-amber-800 bg-amber-50', h: 64 },
  { d: '2026-09-15', cls: 'text-brand-700 bg-brand-50', h: 0 },
  { d: '2026-09-22', cls: 'text-green-800 bg-green-50', h: 14 },
];
const trail = trailMeta.map((m, i) => ({ ...m, label: H.card.rows[i][0], what: H.card.rows[i][1], val: H.card.rows[i][2] }));
// TODO: switch "Built for EU teams" to "EU data hosting" once backend hosting in the EU is confirmed.
const trustIcons = ['ban', 'globe', 'check', 'clock'];
const whyIcons = ['scale', 'chart', 'ban'];
const featIcons = ['chart', 'clock', 'doc', 'file', 'users', 'shield'];
---
<Base title={H.title} description={H.description}>
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-50 via-white to-white">
    <div class="hero-glow" aria-hidden="true"></div><div class="hero-grid" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 pt-14 pb-16 md:pt-24 md:pb-24 grid gap-12 lg:grid-cols-12 items-center">
      <div class="lg:col-span-6">
        <p class="rv inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white px-3 py-1 text-xs font-semibold text-brand-700"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>{H.pill}</p>
        <h1 class="rv mt-6 text-4xl sm:text-5xl lg:text-[3.6rem] font-bold tracking-[-0.03em] leading-[1.08] text-ink" data-d="60">{H.h1}</h1>
        <p class="rv mt-6 text-lg text-muted leading-relaxed max-w-xl lg:max-w-[25rem] xl:max-w-[30rem]" data-d="120">{H.lead}</p>
        <div class="rv mt-8 grid grid-cols-1 sm:flex gap-3" data-d="180">
          <a href="#waitlist" class="btn btn-primary px-6">{H.ctaPrimary}</a>
          <a href={l('/free-scan')} class="btn btn-secondary px-6">{H.ctaSecondary}</a>
        </div>
        <p class="mt-5 text-sm text-muted">{H.trustLine}</p>
      </div>
      <div class="lg:col-span-6">
        <figure class="hero-fig rv" data-d="120" data-seq="final" tabindex="0">
          <figcaption class="sr-only">{D.figSummary}</figcaption>
          <div class="hero-scene" data-tilt="6">
            <div class="hero-scan relative rounded-3xl border border-brand-100 bg-white px-6 pt-6 sm:px-7 sm:pt-7 shadow-2xl shadow-brand-900/15">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <p class="font-semibold text-ink">{D.caption}</p>
                <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700">{D.note}</span>
              </div>
              <div class="mt-5 flex items-center gap-2 rounded-xl border border-brand-200 bg-white px-3.5 py-2.5 font-mono text-sm text-ink">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="#3b5bdb" stroke-width="2"><circle cx="9" cy="9" r="6"/><path d="m14 14 4 4"/></svg>
                <span>{D.url}</span>
              </div>
              <div class="mt-5 flex items-center gap-5">
                <div class="score-ring" role="img" aria-label={D.scoreLabel} aria-describedby="demo-score-note">
                  <svg width="112" height="112" viewBox="0 0 120 120" aria-hidden="true"><circle class="bg" cx="60" cy="60" r="50"/><circle class="fg" cx="60" cy="60" r="50"/></svg>
                  <span aria-hidden="true" class="absolute inset-0 grid place-content-center text-center"><span data-score class="text-3xl font-bold text-ink leading-none tabular-nums">82</span><span class="mt-1 text-[11px] leading-tight text-muted">{D.score}</span></span>
                </div>
                <div class="min-w-0 flex-1" aria-hidden="true">
                  <p class="text-sm text-muted">{D.done} · 48 / 48 {D.pages}</p>
                  <div class="prog mt-2"><span style="width:100%"></span></div>
                  <p class="mt-2 text-xs font-semibold text-ink">{D.scoreSub}</p>
                </div>
              </div>
              <p id="demo-score-note" class="mt-3 text-xs text-muted leading-relaxed">{D.scoreNote}</p>
              <ul class="mt-4 space-y-2 text-sm">
                {D.issues.map(([name, sev, n], i) => (
                  <li class={`demo-issue flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 ${i === 0 ? 'seq-row' : ''}`}>
                    <span class="text-ink">{name}</span>
                    {i === 0 ? (
                      <span class="chip-stack shrink-0 text-xs font-semibold">
                        <span class={`chip-open rounded-full px-2.5 py-0.5 ${sevCls[i]}`} aria-hidden="true">{sev} · {n}</span>
                        <span class="chip-fixed rounded-full bg-green-50 px-2.5 py-0.5 text-green-800">{D.fixedChip} · {n}</span>
                      </span>
                    ) : <span class={`shrink-0 rounded-full px-2.5 py-0.5 text-xs font-semibold ${sevCls[i]}`}>{sev} · {n}</span>}
                  </li>
                ))}
              </ul>
            </div>
            <div class="hero-fix rounded-2xl border border-brand-100 bg-white p-5 shadow-xl shadow-brand-900/15">
              <p class="flex flex-wrap items-center justify-between gap-2 text-xs"><span class="rounded-md bg-brand-50 px-2 py-0.5 font-mono font-semibold text-brand-800">button-name</span><span class="rounded-full bg-slate-100 px-2 py-0.5 text-slate-700">{V.example}</span></p>
              <p class="mt-1.5 text-sm font-semibold text-ink">{V.fix.wcag}</p>
              <pre aria-hidden="true" class="mt-3 overflow-hidden whitespace-pre-wrap break-words rounded-xl bg-slate-900 py-2 font-mono text-[12px] leading-relaxed text-slate-100"><code>{V.fix.lines.map(([m, ln], i) => <span style={`--i:${i}`} class={`diff-ln block px-3 ${m === '-' ? 'bg-red-500/15 text-red-200' : m === '+' ? 'bg-green-500/15 text-green-200' : ''}`}><span class="select-none">{m === ' ' ? '\u00a0' : m} </span>{ln}</span>)}</code></pre>
              <p class="seq-check mt-3 flex items-center gap-1.5 text-xs font-semibold text-green-800"><svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4"><path d="M5 10.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>{V.fix.footer}</p>
            </div>
          </div>
        </figure>
      </div>
    </div>
  </section>

  <section aria-label={H.trustAria} class="border-y border-slate-200 bg-white">
    <ul class="mx-auto max-w-6xl px-4 py-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-sm font-medium text-ink">
      {H.trust.map((x, i) => <li class="flex items-center gap-3"><Tile name={trustIcons[i]} size="sm" />{x}</li>)}
    </ul>
  </section>

  <section aria-labelledby="problem-heading" class="mx-auto max-w-6xl px-4 py-20 md:py-24">
    <p class="eyebrow rv">{H.why.eyebrow}</p>
    <h2 id="problem-heading" class="mt-2 text-3xl md:text-4xl font-bold tracking-tight text-ink rv">{H.why.h2}</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {H.why.items.map(([title, d], i) => (
        <div class="rv lift rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" data-d={i * 90}>
          <Tile name={whyIcons[i]} />
          <h3 class="mt-5 font-semibold text-lg text-ink">{title}</h3>
          <p class="mt-2 text-muted leading-relaxed">{d}</p>
        </div>
      ))}
    </div>
    <div class="mt-16"><p class="eyebrow rv">{V.timeline.eyebrow}</p><h3 class="mt-2 text-2xl font-bold tracking-tight text-ink rv">{V.timeline.h2}</h3><p class="mt-2 text-muted rv">{V.timeline.lead}</p><Timeline /></div>
  </section>

  <section aria-labelledby="affected-heading" class="bg-gradient-to-b from-white to-brand-50/50 border-t border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-24 grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <p class="eyebrow rv">{V.affected.eyebrow}</p>
        <h2 id="affected-heading" class="mt-2 text-3xl md:text-4xl font-bold tracking-tight text-ink rv">{V.affected.h2}</h2>
        <p class="mt-3 text-muted rv">{V.affected.lead}</p>
        <ul class="mt-8 grid grid-cols-2 sm:grid-cols-3 gap-3">
          {V.affected.items.map(([ic, label], i) => <li class="rv lift flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-ink shadow-sm" data-d={i * 60}><Tile name={ic} size="sm" />{label}</li>)}
        </ul>
      </div>
      <div class="lg:col-span-5">
        <div class="rv rounded-2xl border border-brand-200 bg-white p-6 shadow-lg shadow-brand-900/5">
          <div class="flex justify-center"><Spot kind="shop" class="w-full max-w-[220px]" /></div>
          <h3 class="mt-2 font-semibold text-ink">{V.affected.exemptH}</h3>
          <ul class="mt-3 space-y-2 text-sm text-muted">{V.affected.exempt.map((x) => <li class="flex gap-2"><span class="text-brand-700"><Icon name="check" /></span>{x}</li>)}</ul>
          <p class="mt-3 text-xs text-muted">{V.affected.exemptNote}</p>
        </div>
      </div>
    </div>
  </section>

  <section id="how-it-works" aria-labelledby="how-heading" class="bg-slate-50 border-y border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-24">
      <p class="eyebrow rv">{H.how.eyebrow}</p>
      <h2 id="how-heading" class="mt-2 text-3xl md:text-4xl font-bold tracking-tight text-ink rv">{H.how.h2}</h2>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {H.how.steps.map(([title, d], i) => (
          <li class="rv lift rounded-2xl bg-white border border-slate-200 p-6 shadow-sm" data-d={i * 80}>
            <span class="flex items-center gap-3"><Tile name={stepIcons[i]} size="lg" solid /><span aria-hidden="true" class="text-xs font-bold tracking-wider text-brand-700">0{i + 1}</span></span>
            <h3 class="mt-4 font-semibold text-lg text-ink"><span class="sr-only">{H.how.step === '第' ? `第 ${i + 1} 步：` : `Step ${i + 1}: `}</span>{title}</h3>
            <p class="mt-2 text-muted leading-relaxed">{d}</p>
          </li>
        ))}
      </ol>
      <div class="mt-12 grid gap-8 lg:grid-cols-2 lg:items-center">
        <div class="rv"><Coverage /></div>
        <div class="rv text-muted leading-relaxed"><p class="text-5xl font-bold tracking-tight text-gradient">~<span data-to={H.stat.value}>{H.stat.value}</span>{H.stat.suffix}</p><p class="mt-3 font-medium text-ink">{H.stat.label}</p><p class="mt-3 text-sm"><strong class="text-ink">{H.limits.label}</strong> <Fragment set:html={H.limits.html} /></p></div>
      </div>
    </div>
  </section>

  <section aria-labelledby="features-heading" class="mx-auto max-w-6xl px-4 py-20 md:py-24">
    <p class="eyebrow rv">{H.features.eyebrow}</p>
    <h2 id="features-heading" class="mt-2 text-3xl md:text-4xl font-bold tracking-tight text-ink rv">{H.features.h2}</h2>
    <div class="mt-10 grid gap-6 lg:grid-cols-3"><ul class="grid gap-5 sm:grid-cols-2 lg:col-span-2">
      {H.features.items.map(([title, d], i) => (
        <li data-spotlight class="rv spot-card group relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" data-d={(i % 2) * 90}>
          <span aria-hidden="true" class="absolute -right-10 -top-10 h-32 w-32 rounded-full bg-gradient-to-br from-brand-100 to-violet-100 opacity-70 transition-transform duration-500 group-hover:scale-125"></span>
          <Tile name={featIcons[i]} class="relative" />
          <h3 class="relative mt-5 font-semibold text-lg text-ink">{title}</h3><p class="relative mt-2 text-muted leading-relaxed">{d}</p>
        </li>
      ))}
    </ul>
    <div class="grid content-start gap-5"><Snippet kind="score" idp="feat" class="rv" /><Snippet kind="trend" class="rv" /></div></div>
  </section>

  <section aria-labelledby="fix-heading" class="bg-gradient-to-b from-white to-brand-50/60 border-t border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-24">
      <p class="eyebrow rv">{F.eyebrow}</p>
      <h2 id="fix-heading" class="mt-2 text-3xl md:text-4xl font-bold tracking-tight text-ink rv">{F.h2}</h2>
      <p class="mt-3 max-w-2xl text-muted rv">{F.lead}</p>
      <div class="mt-10 grid gap-6 lg:grid-cols-12 lg:items-start">
        <div class="grid min-w-0 gap-5 lg:col-span-7">
          <div class="rv lift rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-sm">
            <p class="flex flex-wrap items-center justify-between gap-2"><span class="font-semibold text-ink">{F.before}</span><span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs text-slate-700">{F.example}</span></p>
            <ul class="mt-4 grid gap-2 text-sm">
              {F.issues.map(([rule, wcag, impact, desc]) => <li class="rounded-xl border border-slate-100 bg-slate-50/70 p-3"><span class="flex flex-wrap items-center gap-1.5 text-xs"><code class="rounded-md bg-brand-50 px-1.5 py-0.5 font-semibold text-brand-800">{rule}</code><span class="text-slate-700">{wcag}</span><span class="rounded-full bg-red-50 px-2 py-0.5 font-semibold text-red-800">{impact}</span></span><span class="mt-1 block text-ink">{desc}</span></li>)}
            </ul>
            <p class="sr-only">{F.diffSr}</p>
            <pre class="mt-4 overflow-hidden whitespace-pre-wrap break-words rounded-xl border border-slate-200 bg-slate-50 py-2 font-mono text-xs leading-relaxed text-slate-800"><code>{F.beforeCode.map(([m, l]) => <span class={`block px-3 ${m === '-' ? 'bg-red-50 text-red-800' : ''}`}><span aria-hidden="true" class="select-none">{m === ' ' ? '\u00a0' : m} </span>{l}</span>)}</code></pre>
          </div>
          <div class="rv lift rounded-2xl border border-brand-200 bg-white p-5 sm:p-6 shadow-lg shadow-brand-900/10" data-d="120">
            <p class="flex flex-wrap items-center justify-between gap-2"><span class="font-semibold text-ink">{F.after}</span><span class="rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-semibold text-green-800">{F.trail[3][2]}</span></p>
            <pre class="mt-4 overflow-hidden whitespace-pre-wrap break-words rounded-xl border border-slate-200 bg-slate-50 py-2 font-mono text-xs leading-relaxed text-slate-800"><code>{F.afterCode.map(([m, l]) => <span class={`block px-3 ${m === '+' ? 'bg-green-50 text-green-900' : ''}`}><span aria-hidden="true" class="select-none">{m === ' ' ? '\u00a0' : m} </span>{l}</span>)}</code></pre>
            <p class="mt-3 text-xs text-slate-700">color-contrast · {F.fixedNote}</p>
          </div>
        </div>
        <div class="grid min-w-0 gap-5 lg:col-span-5">
          <div class="rv rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-sm" data-d="200">
            <h3 class="flex items-center gap-2 font-semibold text-ink"><span class="text-brand-700"><Icon name="archive" /></span>{F.trailH}</h3>
            <ol aria-label={F.trailAria} class="mt-4 space-y-4 border-l-2 border-brand-100 pl-5">
              {F.trail.map(([date, title, detail, id, st]) => <li class="relative"><span aria-hidden="true" class={`absolute -left-[27px] top-1 h-3 w-3 rounded-full ring-4 ring-white ${st === 'done' ? 'bg-green-700' : st === 'manual' ? 'bg-amber-600' : st === 'partial' ? 'bg-brand-500' : 'bg-red-700'}`}></span><p class="flex flex-wrap items-baseline gap-x-2 text-sm"><span class="font-semibold text-ink">{date}</span><span class="text-ink">{title}</span><code class="text-xs text-slate-600">{id}</code></p><p class="mt-0.5 text-sm text-muted">{detail}</p></li>)}
            </ol>
          </div>
          <div class="rv" data-d="260"><BrowserPins /></div>
        </div>
      </div>
      <p class="rv mt-6 flex gap-3 text-sm text-muted"><span class="mt-0.5 text-brand-700"><Icon name="info" /></span>{F.caveat}</p>
    </div>
  </section>

  <section aria-labelledby="pricing-heading" class="bg-brand-50/60 border-b border-slate-200">
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-24">
      <div class="md:flex md:items-end md:justify-between gap-6">
        <div>
          <p class="eyebrow rv">{H.pricing.eyebrow}</p>
          <h2 id="pricing-heading" class="mt-2 text-3xl md:text-4xl font-bold tracking-tight text-ink rv">{H.pricing.h2}</h2>
          <p class="mt-3 text-muted">{H.pricing.lead}</p>
        </div>
        <a class="mt-4 md:mt-0 inline-block font-semibold text-brand-700 underline underline-offset-4 hover:text-brand-900" href={l('/pricing')}>{H.pricing.link}</a>
      </div>
      <div class="mt-12"><Plans /></div>
    </div>
  </section>

  <section aria-labelledby="faq-heading" class="mx-auto max-w-6xl px-4 py-20 md:py-24 grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="eyebrow rv">{H.faq.eyebrow}</p>
      <h2 id="faq-heading" class="mt-2 text-3xl md:text-4xl font-bold tracking-tight text-ink rv">{H.faq.h2}</h2>
      <p class="mt-4 text-muted">{H.faq.more} <a class="text-brand-700 underline" href="mailto:hello@allyfolio.com">hello@allyfolio.com</a>.</p>
    </div>
    <div class="lg:col-span-8"><Faq icons={faqIcons} /></div>
  </section>

  <Waitlist />
</Base>
