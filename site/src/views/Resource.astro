---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { i18n, prefix } from '../i18n';
import { resources, resourceOrder, resourceUi, resourceSources, type ResourceKey } from '../i18n/resources';
interface Props { page: ResourceKey }
const { lang, t, l } = i18n(Astro.url.pathname);
const r = resources[lang][Astro.props.page];
const U = resourceUi[lang];
const related = resourceOrder.filter((k) => k !== Astro.props.page);
---
<Base title={r.title} description={r.description} ogType="article">
  <PageHeader eyebrow={U.eyebrow} title={r.h1} lead={r.lead} updated={t.prose.updated} updatedLabel={t.prose.lastUpdated} />
  <div class="mx-auto max-w-6xl px-4 py-14 grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-8">
      <p class="flex gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900"><span class="shrink-0"><Icon name="info" /></span><span><strong>{U.disclaimerLabel}</strong> {U.disclaimer}</span></p>
      <article class="mt-8 prose prose-slate max-w-none prose-headings:text-ink prose-headings:tracking-tight prose-h2:mt-10 prose-a:text-brand-700 prose-p:text-muted prose-li:text-muted prose-strong:text-ink">
        <Fragment set:html={r.html(prefix(lang))} />
      </article>
      <section aria-labelledby="res-cta" class="mt-12 rounded-2xl bg-brand-50 border border-brand-200 p-8">
        <h2 id="res-cta" class="text-xl font-semibold text-ink">{U.ctaH}</h2>
        <p class="mt-2 text-muted">{U.ctaP}</p>
        <div class="mt-5 grid grid-cols-1 sm:flex gap-3">
          <a href={l('/free-scan')} class="btn btn-primary">{U.ctaScan}</a>
          <a href={l('/pricing')} class="btn btn-secondary">{U.ctaPricing}</a>
        </div>
      </section>
    </div>
    <aside class="lg:col-span-4 space-y-8">
      <nav aria-labelledby="res-related" class="rounded-2xl border border-slate-200 bg-white p-6">
        <h2 id="res-related" class="font-semibold text-ink">{U.related}</h2>
        <ul class="mt-4 space-y-3 text-sm">
          {related.map((k) => <li class="flex items-start gap-2.5"><span class="text-brand-500"><Icon name={resources[lang][k].icon} /></span><a class="text-brand-700 underline underline-offset-4" href={l(`/${k}`)}>{resources[lang][k].short}</a></li>)}
          <li class="flex items-start gap-2.5"><span class="text-brand-500"><Icon name="file" /></span><a class="text-brand-700 underline underline-offset-4" href={l('/resources')}>{t.footer.allResources}</a></li>
        </ul>
      </nav>
      <section aria-labelledby="res-sources" class="rounded-2xl border border-slate-200 bg-white p-6">
        <h2 id="res-sources" class="font-semibold text-ink">{U.sources}</h2>
        <ul class="mt-4 space-y-3 text-sm">
          {resourceSources(Astro.props.page).map(([label, href]) => <li><a class="text-brand-700 underline underline-offset-4 break-words" href={href}>{label}</a></li>)}
        </ul>
      </section>
    </aside>
  </div>
</Base>
