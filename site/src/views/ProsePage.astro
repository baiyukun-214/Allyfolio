---
import Prose from '../layouts/Prose.astro';
import Tile from '../components/Tile.astro';
import Icon from '../components/Icon.astro';
import { i18n } from '../i18n';
import { prosePages } from '../i18n/pages';
interface Props { page: 'about' | 'privacy' | 'imprint' | 'statement' | 'terms' | 'dpa' }
const { lang, t } = i18n(Astro.url.pathname);
const p = prosePages[lang][Astro.props.page];
const V = t.visuals;
const legal = p.eyebrow === 'legal';
// Give h2s stable ids and build a small table of contents for longer legal pages.
const heads: string[] = [];
const html = p.html.replace(/<h2>(.*?)<\/h2>/g, (_m, h) => { heads.push(h); return `<h2 id="s-${heads.length}">${h}</h2>`; });
const showToc = legal && heads.length >= 4;
---
<Prose eyebrow={legal ? t.prose.legal : t.prose.about} title={p.title} description={p.description}>
  {Astro.props.page === 'about' && (
    <section aria-labelledby="values-h" class="not-prose mb-10">
      <h2 id="values-h" class="text-2xl font-bold tracking-tight text-ink">{V.valuesH}</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-3">
        {V.values.map(([ic, h, d]) => <li class="lift rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><Tile name={ic} /><h3 class="mt-4 font-semibold text-ink">{h}</h3><p class="mt-1 text-sm leading-relaxed text-muted">{d}</p></li>)}
      </ul>
    </section>
  )}
  {showToc && (
    <nav aria-labelledby="toc-h" class="not-prose prose-toc mb-10 rounded-2xl border border-brand-100 bg-brand-50/50 p-5">
      <h2 id="toc-h" class="flex items-center gap-2 text-sm font-semibold text-ink"><span class="text-brand-700"><Icon name="doc" /></span>{V.toc}</h2>
      <ol class="mt-3 grid gap-1 text-sm sm:grid-cols-2">{heads.map((h, i) => <li><a class="block rounded-md px-2 py-1 text-brand-700 hover:bg-white hover:underline" href={`#s-${i + 1}`} set:html={h} /></li>)}</ol>
    </nav>
  )}
  <Fragment set:html={html} />
</Prose>
