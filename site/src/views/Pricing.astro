---
import Base from '../layouts/Base.astro';
import Plans from '../components/Plans.astro';
import Faq from '../components/Faq.astro';
import Waitlist from '../components/Waitlist.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { i18n } from '../i18n';
const { t } = i18n(Astro.url.pathname);
const P = t.pricing;
// TODO: switch "Built for EU teams" to "EU data hosting" once backend hosting in the EU is confirmed.
const icons = ['check', 'doc', 'clock', 'globe', 'ban'];
---
<Base title={P.title} description={P.description}>
  <PageHeader eyebrow={P.eyebrow} title={P.h1} lead={P.lead} />
  <div class="mx-auto max-w-6xl px-4 py-16">
    <section aria-labelledby="plans-heading" class="pt-4">
      <h2 id="plans-heading" class="sr-only">{P.plansSr}</h2>
      <Plans detailed />
    </section>
    <section aria-labelledby="included-heading" class="mt-20 rounded-2xl border border-slate-200 p-8 md:p-10">
      <h2 id="included-heading" class="text-2xl font-bold tracking-tight text-ink">{P.includedH}</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {P.included.map((x, i) => <li class="flex items-start gap-3 text-ink"><span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-700"><Icon name={icons[i]} /></span><span class="pt-1">{x}</span></li>)}
      </ul>
      <p class="mt-8 border-t border-slate-200 pt-6 text-sm text-muted">{P.disclaimer}</p>
    </section>
    <section aria-labelledby="pfaq-heading" class="mt-20 grid gap-10 lg:grid-cols-12">
      <h2 id="pfaq-heading" class="lg:col-span-4 text-2xl font-bold tracking-tight text-ink">{P.faqH}</h2>
      <div class="lg:col-span-8"><Faq items={P.faq} /></div>
    </section>
  </div>
  <Waitlist />
</Base>
