---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Waitlist from '../components/Waitlist.astro';
import Icon from '../components/Icon.astro';
import { i18n } from '../i18n';
const { t, l } = i18n(Astro.url.pathname);
const H = t.home; const P = t.featuresPage;
const featIcons = ['chart', 'clock', 'doc', 'file', 'users', 'shield'];
---
<Base title={P.title} description={P.description}>
  <PageHeader eyebrow={H.features.eyebrow} title={P.h1} lead={P.lead}>
    <div class="mt-8 grid grid-cols-1 sm:flex gap-3">
      <a href={l('/#waitlist')} class="btn btn-primary px-6">{H.ctaPrimary}</a>
      <a href={l('/free-scan')} class="btn btn-secondary px-6">{H.ctaSecondary}</a>
    </div>
  </PageHeader>
  <section aria-labelledby="feat-list" class="mx-auto max-w-6xl px-4 py-16">
    <h2 id="feat-list" class="text-3xl font-bold tracking-tight text-ink">{H.features.h2}</h2>
    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {H.features.items.map(([title, d], i) => (
        <li class="lift relative rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <span class="grid h-11 w-11 place-items-center rounded-xl bg-gradient-to-br from-brand-700 to-indigo-600 text-white shadow-md shadow-brand-900/20"><Icon name={featIcons[i]} /></span>
          <h3 class="mt-5 font-semibold text-lg text-ink">{title}</h3><p class="mt-2 text-muted leading-relaxed">{d}</p>
        </li>
      ))}
    </ul>
  </section>
  <section aria-labelledby="feat-how" class="border-y border-slate-200 bg-brand-50/60">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 id="feat-how" class="text-3xl font-bold tracking-tight text-ink">{H.how.h2}</h2>
      <ol class="mt-10 grid gap-6 md:grid-cols-4">
        {H.how.steps.map(([title, d], i) => (
          <li class="rounded-2xl border border-slate-200 bg-white p-6">
            <span aria-hidden="true" class="grid h-9 w-9 place-items-center rounded-full bg-brand-700 text-sm font-semibold text-white">{i + 1}</span>
            <h3 class="mt-4 font-semibold text-lg text-ink">{title}</h3><p class="mt-2 text-muted leading-relaxed">{d}</p>
          </li>
        ))}
      </ol>
      <p class="mt-8 flex gap-3 text-sm text-muted"><span class="mt-0.5 text-brand-700"><Icon name="info" /></span><span><strong class="text-ink">{H.limits.label}</strong> <Fragment set:html={H.limits.html} /></span></p>
    </div>
  </section>
  <section aria-labelledby="feat-next" class="mx-auto max-w-6xl px-4 py-16">
    <h2 id="feat-next" class="text-2xl font-bold tracking-tight text-ink">{P.nextH}</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-3">
      <li><a class="font-semibold text-brand-700 underline underline-offset-4" href={l('/pricing')}>{P.pricing}</a></li>
      <li><a class="font-semibold text-brand-700 underline underline-offset-4" href={l('/free-scan')}>{P.scan}</a></li>
      <li><a class="font-semibold text-brand-700 underline underline-offset-4" href={l('/resources')}>{P.resources}</a></li>
    </ul>
  </section>
  <Waitlist />
</Base>
