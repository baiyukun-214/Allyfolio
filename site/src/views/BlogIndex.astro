---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { readingTime } from '../lib/reading';
import { i18n } from '../i18n';
import { postSlug } from '../lib/posts';
import BlogCover from '../components/BlogCover.astro';
const { t, l, lang } = i18n(Astro.url.pathname);
const B = t.blog;
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === lang)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toLocaleDateString(B.dateLocale, { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={B.title} description={B.description}>
  <PageHeader eyebrow={B.eyebrow} title={B.h1} lead={B.lead} />
  <div class="mx-auto max-w-6xl px-4 py-14">
    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((p, i) => (
        <li class="group relative flex flex-col rounded-2xl border border-slate-200 bg-white p-6 hover:border-brand-200 hover:shadow-lg hover:shadow-brand-900/5 transition">
          <BlogCover tags={p.data.tags} seed={i} />
          <ul class="flex flex-wrap gap-2" aria-label={B.tags}>{p.data.tags.map((x) => <li class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-semibold text-brand-700">{x}</li>)}</ul>
          <h2 class="mt-4 text-xl font-semibold tracking-tight text-ink"><a class="after:absolute after:inset-0 group-hover:text-brand-700" href={l(`/blog/${postSlug(p.id)}`)}>{p.data.title}</a></h2>
          <p class="mt-3 flex-1 text-muted leading-relaxed">{p.data.description}</p>
          <p class="mt-6 text-sm text-muted"><time datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time> · {B.minRead(readingTime(p.body, lang))}</p>
        </li>
      ))}
    </ul>
  </div>
</Base>
