---
import Base from './Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { i18n } from '../i18n';
interface Props { title: string; description: string; eyebrow?: string }
const { title, description, eyebrow } = Astro.props;
const { t } = i18n(Astro.url.pathname);
---
<Base title={title} description={description}>
  <PageHeader title={title} eyebrow={eyebrow} updated={t.prose.updated} updatedLabel={t.prose.lastUpdated} narrow />
  <article class="mx-auto max-w-3xl px-4 py-14 prose prose-slate prose-headings:text-ink prose-headings:tracking-tight prose-h2:mt-10 prose-a:text-brand-700 prose-p:text-muted prose-li:text-muted">
    <slot />
  </article>
</Base>
