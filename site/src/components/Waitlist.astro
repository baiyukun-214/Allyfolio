---
import { API_BASE } from '../lib/api';
import { i18n } from '../i18n';
const { t, l, lang } = i18n(Astro.url.pathname);
const w = t.waitlist;
---
<section id="waitlist" aria-labelledby="waitlist-heading" class="px-4 py-20">
  <div class="relative mx-auto max-w-5xl overflow-hidden rounded-3xl bg-brand-700 px-6 py-14 md:px-14 text-white">
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-brand-500/40 blur-3xl"></div>
    <div class="relative md:flex md:items-center md:justify-between md:gap-12">
      <div class="max-w-md">
        <h2 id="waitlist-heading" class="text-3xl font-bold tracking-tight">{w.heading}</h2>
        <p class="mt-3 text-brand-100">{w.lead}</p>
      </div>
      <form id="waitlist-form" action={`${API_BASE}/api/waitlist`} data-api={API_BASE} data-ok={w.ok} data-fail={w.fail} data-network={w.network} data-sending={w.sending} method="post" class="mt-8 md:mt-0 w-full md:max-w-md">
        <input type="hidden" name="lang" value={lang} />
        <label for="waitlist-email" class="block text-sm font-medium">{w.label}</label>
        <div class="mt-2 flex flex-col sm:flex-row gap-3">
          <input id="waitlist-email" name="email" type="email" required autocomplete="email" placeholder={w.placeholder} class="h-12 min-w-0 flex-1 rounded-lg border-0 bg-white px-4 text-ink placeholder:text-slate-500 focus-visible:outline-white" />
          <button type="submit" id="waitlist-submit" class="btn h-12 bg-white text-brand-700 hover:bg-brand-50 focus-visible:outline-white">{w.button}</button>
        </div>
        <p id="waitlist-status" role="status" aria-live="polite" class="mt-3 text-sm font-medium text-white empty:hidden"></p>
        <p class="mt-3 text-sm text-brand-100">{w.privacy} <a class="underline text-white" href={l('/privacy')}>{w.privacyLink}</a>.</p>
      </form>
    </div>
  </div>
</section>
<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
  const status = document.getElementById('waitlist-status');
  const btn = document.getElementById('waitlist-submit') as HTMLButtonElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status || !btn) return;
    const d = form.dataset;
    const email = (form.elements.namedItem('email') as HTMLInputElement).value;
    const lang = (form.elements.namedItem('lang') as HTMLInputElement).value;
    btn.disabled = true; status.textContent = d.sending ?? '';
    try {
      const res = await fetch(`${d.api}/api/waitlist`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email, lang }) });
      const j = await res.json().catch(() => ({}));
      status.textContent = res.ok ? (d.ok ?? '') : (j.error ?? d.fail ?? '');
      if (res.ok) form.reset();
    } catch { status.textContent = d.network ?? ''; }
    finally { btn.disabled = false; }
  });
</script>
