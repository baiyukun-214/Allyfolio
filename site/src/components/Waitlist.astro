---
---
<section id="waitlist" aria-labelledby="waitlist-heading" class="bg-brand-900 text-white">
  <div class="mx-auto max-w-3xl px-4 py-16 text-center">
    <h2 id="waitlist-heading" class="text-3xl font-bold">Join the waitlist</h2>
    <p class="mt-3 text-brand-100">Be first to try Allyfolio. Early waitlist members get a discounted first year.</p>
    <!-- TODO: replace mailto with a POST to the waitlist API (e.g. /api/waitlist on Cloudflare Pages Functions) once it exists. -->
    <form action="mailto:hello@allyfolio.com?subject=Allyfolio%20waitlist" method="post" enctype="text/plain" class="mt-8 flex flex-col sm:flex-row gap-3 justify-center items-stretch sm:items-end text-left">
      <div class="flex flex-col">
        <label for="waitlist-email" class="text-sm font-medium">Work email</label>
        <input id="waitlist-email" name="email" type="email" required autocomplete="email" class="mt-1 rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 sm:w-80" />
      </div>
      <button type="submit" class="rounded-md bg-amber-400 px-5 py-2 font-semibold text-slate-900 hover:bg-amber-300">Join the waitlist</button>
    </form>
    <p class="mt-4 text-sm text-brand-100">This opens your email app. Prefer to write yourself? <a class="underline text-white" href="mailto:hello@allyfolio.com?subject=Allyfolio%20waitlist">Email hello@allyfolio.com</a>.</p>
  </div>
</section>
