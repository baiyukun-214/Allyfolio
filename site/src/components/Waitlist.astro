---
import { API_BASE } from '../lib/api';
---
<section id="waitlist" aria-labelledby="waitlist-heading" class="px-4 py-20">
  <div class="relative mx-auto max-w-5xl overflow-hidden rounded-3xl bg-brand-700 px-6 py-14 md:px-14 text-white">
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-brand-500/40 blur-3xl"></div>
    <div class="relative md:flex md:items-center md:justify-between md:gap-12">
      <div class="max-w-md">
        <h2 id="waitlist-heading" class="text-3xl font-bold tracking-tight">Join the waitlist</h2>
        <p class="mt-3 text-brand-100">Be first to try Allyfolio. The first 100 waitlist members get 30% off their first year.</p>
      </div>
      <form id="waitlist-form" action={`${API_BASE}/api/waitlist`} data-api={API_BASE} method="post" class="mt-8 md:mt-0 w-full md:max-w-md">
        <label for="waitlist-email" class="block text-sm font-medium">Work email</label>
        <div class="mt-2 flex flex-col sm:flex-row gap-3">
          <input id="waitlist-email" name="email" type="email" required autocomplete="email" placeholder="you@company.eu" class="h-12 min-w-0 flex-1 rounded-lg border-0 bg-white px-4 text-ink placeholder:text-slate-500 focus-visible:outline-white" />
          <button type="submit" id="waitlist-submit" class="btn h-12 bg-white text-brand-700 hover:bg-brand-50 focus-visible:outline-white">Join the waitlist</button>
        </div>
        <p id="waitlist-status" role="status" aria-live="polite" class="mt-3 text-sm font-medium text-white empty:hidden"></p>
        <p class="mt-3 text-sm text-brand-100">We send one email to confirm your address (double opt-in). No spam; unsubscribe any time. See our <a class="underline text-white" href="/privacy">privacy policy</a>.</p>
      </form>
    </div>
  </div>
</section>
<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
  const status = document.getElementById('waitlist-status');
  const btn = document.getElementById('waitlist-submit') as HTMLButtonElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status || !btn) return;
    const email = (form.elements.namedItem('email') as HTMLInputElement).value;
    btn.disabled = true; status.textContent = 'Sending…';
    try {
      const res = await fetch(`${form.dataset.api}/api/waitlist`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email }) });
      const j = await res.json().catch(() => ({}));
      status.textContent = res.ok ? 'Almost done – check your inbox and click the link to confirm your email.' : (j.error ?? 'Something went wrong. Please try again.');
      if (res.ok) form.reset();
    } catch { status.textContent = 'We could not reach the server. Please try again or email hello@allyfolio.com.'; }
    finally { btn.disabled = false; }
  });
</script>
