---
// Cropped "real-looking" UI cards used as imagery. Example data, labelled as such.
import { i18n } from '../i18n';
interface Props { kind: 'score' | 'trend' | 'fix'; class?: string; idp?: string }
const { t } = i18n(Astro.url.pathname); const V = t.visuals; const { kind, idp = 'snip' } = Astro.props;
const C = 2 * Math.PI * 50;
---
<div class={`snippet rounded-2xl border border-brand-100 bg-white p-5 shadow-xl shadow-brand-900/10 ${Astro.props.class ?? ''}`}>
  {kind === 'score' && (
    <div class="flex items-center gap-4">
      <svg role="img" aria-label={V.score.aria} aria-describedby={`${idp}-score-note`} width="84" height="84" viewBox="0 0 120 120" class="shrink-0"><circle cx="60" cy="60" r="50" fill="none" stroke="#e0e7ff" stroke-width="12"/><circle cx="60" cy="60" r="50" fill="none" stroke="#4f46e5" stroke-width="12" stroke-linecap="round" stroke-dasharray={C.toFixed(1)} stroke-dashoffset={(C * 0.18).toFixed(1)} transform="rotate(-90 60 60)"/><text x="60" y="69" text-anchor="middle" font-size="30" font-weight="700" fill="#0f172a">82</text></svg>
      <div><p class="text-sm font-semibold text-ink">{V.score.label} <span class="font-normal text-muted">· {V.score.outOf}</span></p><p id={`${idp}-score-note`} class="mt-1 text-xs leading-relaxed text-muted">{V.score.note}</p></div>
    </div>
  )}
  {kind === 'trend' && (
    <div>
      <p class="flex items-center justify-between text-sm text-muted"><span>{V.trend.label}</span><span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs">{V.example}</span></p>
      <p class="mt-1 text-3xl font-bold tracking-tight text-ink">{V.trend.value}</p>
      <svg role="img" aria-label={V.trend.aria} viewBox="0 0 160 44" class="mt-2 h-11 w-full"><polyline points="2,6 50,16 100,30 158,40" fill="none" stroke="#4f46e5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="158" cy="40" r="3.5" fill="#4f46e5"/></svg>
      <p class="mt-1 text-sm font-semibold text-green-800">▼ {V.trend.delta}</p>
    </div>
  )}
  {kind === 'fix' && (
    <div>
      <p class="flex flex-wrap items-center justify-between gap-2 text-xs"><span class="rounded-md bg-brand-50 px-2 py-0.5 font-mono font-semibold text-brand-800">button-name</span><span class="rounded-full bg-slate-100 px-2 py-0.5 text-slate-700">{V.example}</span></p>
      <p class="mt-1.5 text-sm font-semibold text-ink">{V.fix.wcag}</p>
      <p class="sr-only">{V.fix.srDiff}</p>
      <pre class="mt-3 overflow-hidden whitespace-pre-wrap break-words rounded-xl border border-slate-200 bg-slate-50 py-2 font-mono text-[11px] leading-relaxed text-slate-800"><code>{V.fix.lines.map(([m, l]) => <span class={`block px-3 ${m === '-' ? 'bg-red-50 text-red-800' : m === '+' ? 'bg-green-50 text-green-900' : ''}`}><span aria-hidden="true" class="select-none">{m === ' ' ? '\u00a0' : m} </span>{l}</span>)}</code></pre>
      <p class="mt-3 flex items-center gap-1.5 text-xs font-semibold text-green-800"><svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4"><path d="M5 10.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>{V.fix.footer}</p>
    </div>
  )}
</div>
