---
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import { appLink } from '../lib/api';
import { i18n, basePath } from '../i18n';
interface Props { hasTranslation?: boolean }
const { lang, t, l } = i18n(Astro.url.pathname);
const links = [
  { href: '/#how-it-works', label: t.nav.how },
  { href: '/pricing', label: t.nav.pricing },
  { href: '/free-scan', label: t.nav.freeScan },
  { href: '/blog', label: t.nav.blog },
  { href: '/about', label: t.nav.about },
];
const current = basePath(Astro.url.pathname);
const linkCls = 'block rounded-md px-3 py-2 text-sm font-medium text-muted hover:bg-brand-50 hover:text-brand-700';
---
<header id="site-header" class="site-header glass sticky top-0 z-40 border-b border-slate-200/70">
  <div class="mx-auto max-w-6xl px-4 py-4 flex items-center justify-between gap-4">
    <a href={l('/')} class="flex items-center gap-2.5 font-semibold text-lg tracking-tight text-ink">
      <Logo size={30} />
      <span>Allyfolio</span>
    </a>
    <button id="nav-toggle" type="button" class="lg:hidden inline-flex items-center gap-2 rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-ink" aria-expanded="false" aria-controls="site-nav">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M2 4h16v2H2zm0 5h16v2H2zm0 5h16v2H2z"/></svg>
      {t.nav.menu}
    </button>
    <nav id="site-nav" aria-label={t.nav.main} class="hidden lg:block absolute lg:static left-0 right-0 top-full bg-white border-b lg:border-0 border-slate-200 shadow-lg lg:shadow-none z-40">
      <ul class="flex flex-col lg:flex-row lg:items-center gap-1 lg:gap-1 p-4 lg:p-0">
        {links.map((x) => (
          <li><a href={l(x.href)} aria-current={current === x.href ? 'page' : undefined} class={`${linkCls} aria-[current=page]:text-brand-700 aria-[current=page]:underline decoration-2 underline-offset-8`}>{x.label}</a></li>
        ))}
        <li class="lg:ml-1 lg:pl-2 lg:border-l lg:border-slate-200 mt-2 lg:mt-0 border-t border-slate-200 pt-2 lg:pt-0"><LangSwitch class={linkCls} hasTranslation={Astro.props.hasTranslation} /></li>
        <li data-auth="out"><a href={appLink('/login', lang)} class={linkCls}>{t.nav.login}</a></li>
        <li data-auth="out"><a href={appLink('/signup', lang)} class="btn btn-secondary w-full lg:w-auto py-2 text-sm">{t.nav.signup}</a></li>
        <li data-auth="in" hidden><a href={appLink('/app', lang)} class="btn btn-secondary w-full lg:w-auto py-2 text-sm">{t.nav.dashboard}</a></li>
        <li class="lg:ml-1 mt-2 lg:mt-0"><a href={l('/#waitlist')} class="btn btn-primary w-full lg:w-auto py-2 text-sm">{t.nav.waitlist}</a></li>
      </ul>
    </nav>
  </div>
</header>
<script>
  // Logged-in hint: the app sets a non-HttpOnly af_logged_in=1 cookie on the shared domain. Without JS, Log in / Sign up stay visible.
  if (/(?:^|;\s*)af_logged_in=1(?:;|$)/.test(document.cookie)) document.querySelectorAll<HTMLElement>('[data-auth]').forEach((el) => { el.hidden = el.dataset.auth === 'out'; });
  const btn = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  if (btn && nav) {
    const close = () => { btn.setAttribute('aria-expanded', 'false'); nav.classList.add('hidden'); };
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      nav.classList.toggle('hidden', open);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { close(); btn.focus(); }
    });
  }
</script>
<script>
  // Hide on scroll down, show on scroll up / after ~200 ms idle / near the top / while focused or the menu is open.
  // Without JS the header simply stays sticky and visible.
  const h = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  if (h) {
    let lastY = scrollY, ticking = false, idle = 0, focused = false;
    const set = (hide: boolean) => h.classList.toggle('is-hidden', hide);
    const pinned = () => focused || toggle?.getAttribute('aria-expanded') === 'true' || scrollY < h.offsetHeight + 16;
    const update = () => {
      ticking = false; const y = scrollY;
      if (pinned()) set(false); else if (y > lastY + 2) set(true); else if (y < lastY - 2) set(false);
      lastY = y;
      clearTimeout(idle); idle = window.setTimeout(() => set(false), 200);
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    h.addEventListener('focusin', () => { focused = true; set(false); });
    h.addEventListener('focusout', (e) => { if (!h.contains(e.relatedTarget as Node)) focused = false; });
    toggle?.addEventListener('click', () => set(false));
  }
</script>
