---
// Shared gradients for spot illustrations, rendered once per page (referenced by url(#…)).
---
<svg aria-hidden="true" focusable="false" width="0" height="0" style="position:absolute">
  <defs>
    <linearGradient id="af-top" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#eef2ff"/><stop offset="1" stop-color="#ddd6fe"/></linearGradient>
    <linearGradient id="af-left" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#a5b4fc"/><stop offset="1" stop-color="#818cf8"/></linearGradient>
    <linearGradient id="af-right" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6366f1"/><stop offset="1" stop-color="#4338ca"/></linearGradient>
  </defs>
</svg>
