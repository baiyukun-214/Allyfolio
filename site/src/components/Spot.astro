---
// Soft 3D spot illustrations (accent only, decorative). Uses gradients from SvgDefs.
interface Props { kind: 'shop' | 'report' | 'browser' | 'mail'; class?: string }
const { kind } = Astro.props;
const block = (x: number, y: number, h: number, s = 1) => `<g transform="translate(${x} ${y}) scale(${s})"><path d="M0 0l40-22 40 22-40 22z" fill="url(#af-top)"/><path d="M0 0v${h}l40 22V22z" fill="url(#af-left)"/><path d="M80 0v${h}L40 ${22 + h}V22z" fill="url(#af-right)"/></g>`;
const check = (x: number, y: number, r = 16) => `<g transform="translate(${x} ${y})"><circle r="${r}" fill="url(#af-right)"/><path d="M${-r * .42} 0l${r * .28} ${r * .28} ${r * .5}-${r * .55}" stroke="#fff" stroke-width="${r * .22}" fill="none" stroke-linecap="round" stroke-linejoin="round"/></g>`;
const art: Record<string, string> = {
  shop: block(30, 96, 18, .8) + block(84, 80, 34, .8) + block(138, 96, 18, .8)
    + `<g transform="translate(92 30)"><rect width="48" height="38" rx="7" fill="#fff" stroke="#c7d2fe" stroke-width="2"/><path d="M10 14h4l3 12h14l3-9H16" fill="none" stroke="#4f46e5" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></g>` + check(160, 46, 13),
  report: `<g transform="translate(58 22)"><rect width="84" height="106" rx="12" fill="#fff" stroke="#c7d2fe" stroke-width="2"/><rect x="14" y="18" width="44" height="8" rx="4" fill="#a5b4fc"/><rect x="14" y="36" width="56" height="6" rx="3" fill="#e0e7ff"/><rect x="14" y="50" width="48" height="6" rx="3" fill="#e0e7ff"/><path d="M14 88l14-14 12 8 20-22" stroke="#4f46e5" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/></g>` + check(146, 124, 18),
  browser: block(50, 100, 16, 1.25) + `<g transform="translate(46 22)"><rect width="108" height="78" rx="10" fill="#fff" stroke="#c7d2fe" stroke-width="2"/><rect width="108" height="16" rx="10" fill="#eef2ff"/><circle cx="12" cy="8" r="3" fill="#c7d2fe"/><circle cx="22" cy="8" r="3" fill="#c7d2fe"/><rect x="14" y="30" width="52" height="8" rx="4" fill="#e0e7ff"/><rect x="14" y="46" width="80" height="6" rx="3" fill="#eef2ff"/><rect x="14" y="58" width="64" height="6" rx="3" fill="#eef2ff"/></g><g transform="translate(150 40)"><circle r="16" fill="#fff" stroke="#a5b4fc" stroke-width="3"/><path d="M-5 -6a5 5 0 119 3c-2 1.3-3 2-3 4M1 8v1" stroke="#4f46e5" stroke-width="3" fill="none" stroke-linecap="round"/></g>`,
  mail: block(60, 104, 14, 1) + `<g transform="translate(56 34)"><rect width="88" height="62" rx="10" fill="#fff" stroke="#c7d2fe" stroke-width="2"/><path d="M6 8l38 28 38-28" fill="none" stroke="#818cf8" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></g>` + check(146, 36, 15),
};
---
<svg aria-hidden="true" focusable="false" class={Astro.props.class ?? 'w-full max-w-[260px]'} viewBox="0 0 200 165"><ellipse cx="100" cy="150" rx="74" ry="13" fill="#ddd6fe" opacity=".5"/><Fragment set:html={art[kind]} /></svg>
