---
interface Props { title: string; eyebrow?: string; lead?: string; updated?: string; updatedLabel?: string; narrow?: boolean }
const { title, eyebrow, lead, updated, updatedLabel = "Last updated", narrow } = Astro.props;
---
<div class="border-b border-slate-200 bg-gradient-to-b from-brand-50 to-white">
  <div class={`mx-auto px-4 pt-16 pb-12 ${narrow ? 'max-w-3xl' : 'max-w-6xl'}`}>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-2 text-4xl md:text-5xl font-bold tracking-tight text-ink">{title}</h1>
    {lead && <p class="mt-4 max-w-2xl text-lg text-muted leading-relaxed">{lead}</p>}
    {updated && <p class="mt-4 text-sm text-muted">{updatedLabel}: {updated}</p>}
    <slot />
  </div>
</div>
