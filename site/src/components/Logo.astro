---
/**
 * Allyfolio mark (direction B: page + scan arcs = continuous monitoring).
 * Decorative by default (sits next to the visible "Allyfolio" wordmark). Pass `label` when used alone.
 * variant: 'light' (on light UI) | 'dark' (on #0b1020-type surfaces; brighter tile for >=3:1 contrast).
 */
interface Props { size?: number; variant?: 'light' | 'dark'; label?: string; class?: string }
const { size = 32, variant = 'light', label, class: cls } = Astro.props;
// Same family as .tile-solid (135deg #1e3a8a -> #4f46e5). Dark: #3b5bdb -> #6366f1 keeps >=3:1 against #0b1020.
const stops = variant === 'dark' ? ['#3b5bdb', '#6366f1'] : ['#1e3a8a', '#4f46e5'];
const gid = `afg-${variant}-${Math.random().toString(36).slice(2, 8)}`;
const accent = variant === 'dark' ? '#e0e7ff' : '#c7d2fe';
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---
<svg width={size} height={size} viewBox="0 0 64 64" focusable="false" class={cls} {...a11y}>{label && <title>{label}</title>}<defs><linearGradient id={gid} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color={stops[0]}/><stop offset="1" stop-color={stops[1]}/></linearGradient></defs><rect width="64" height="64" rx="16" fill={`url(#${gid})`}/><path d="M16 14h18l10 10v26a3 3 0 0 1-3 3H16a3 3 0 0 1-3-3V17a3 3 0 0 1 3-3z" fill="none" stroke="#fff" stroke-width="4.5" stroke-linejoin="round"/><path d="M20 27h12M20 35h8" stroke="#fff" stroke-width="4" stroke-linecap="round"/><path d="M40 40a8 8 0 0 1 8 8M40 31a17 17 0 0 1 17 17" fill="none" stroke={accent} stroke-width="4.5" stroke-linecap="round"/><circle cx="40" cy="48" r="3.5" fill={accent}/></svg>
