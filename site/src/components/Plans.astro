---
import Icon from './Icon.astro';
interface Props { detailed?: boolean }
const { detailed = false } = Astro.props;
const plans = [
  { name: 'Starter', price: '€19', blurb: 'For a single small business website.', features: ['1 website', 'Up to 100 pages', 'Weekly scans', '12-month evidence history', '1 seat'], extra: ['Timestamped audit trail', 'Draft accessibility statement'] },
  { name: 'Business', price: '€39', blurb: 'For shops and services with bigger sites.', features: ['3 websites', 'Up to 500 pages per site', 'Daily scans', '24-month evidence history', 'PDF report export', '3 seats'], extra: ['Everything in Starter'], highlight: true },
  { name: 'Agency', price: '€99', blurb: 'For web agencies managing client sites.', features: ['15 websites', 'Up to 1,000 pages per site', 'Daily scans', '24-month evidence history', 'White-label (agency-branded) reports', '10 seats'], extra: ['Everything in Business'] },
];
const shown = (p: typeof plans[number]) => detailed ? [...p.features, ...p.extra] : p.features.slice(0, 4);
---
<div class="grid gap-6 md:grid-cols-3 md:items-stretch">
  {plans.map((p) => (
    <div class={`relative rounded-2xl p-7 flex flex-col ${p.highlight ? 'bg-brand-700 text-white shadow-xl shadow-brand-900/20 md:-my-3 md:py-10' : 'bg-white border border-slate-200'}`}>
      {p.highlight && <p class="absolute -top-3 left-7 rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-700">Recommended</p>}
      <h3 class={`text-lg font-semibold ${p.highlight ? 'text-white' : 'text-ink'}`}>{p.name}</h3>
      <p class={`mt-1 text-sm ${p.highlight ? 'text-brand-100' : 'text-muted'}`}>{p.blurb}</p>
      <p class="mt-6 flex items-baseline gap-1.5"><span class="text-5xl font-bold tracking-tight">{p.price}</span><span class={`text-sm ${p.highlight ? 'text-brand-100' : 'text-muted'}`}>/month</span></p>
      <p class={`mt-1 text-xs ${p.highlight ? 'text-brand-100' : 'text-muted'}`}>excl. VAT</p>
      <ul class={`mt-6 space-y-3 text-sm flex-1 border-t pt-6 ${p.highlight ? 'border-white/20' : 'border-slate-200'}`}>
        {shown(p).map((f) => (<li class="flex gap-2.5"><span class={p.highlight ? 'text-brand-200' : 'text-brand-500'}><Icon name="check" /></span>{f}</li>))}
      </ul>
      <a href="/#waitlist" class={`btn mt-8 w-full ${p.highlight ? 'bg-white text-brand-700 hover:bg-brand-50 focus-visible:outline-white' : 'btn-secondary'}`}>Join the waitlist<span class="sr-only"> for {p.name}</span></a>
    </div>
  ))}
</div>
{detailed && (
<div class="mt-10 rounded-2xl border border-dashed border-brand-200 bg-brand-50 p-6 md:flex md:items-center md:justify-between gap-6">
  <div>
    <h3 class="text-lg font-semibold text-ink">One-off report <span class="text-brand-700">– €39</span></h3>
    <p class="mt-1 text-muted">1 site, up to 100 pages, a single scan and a PDF report. No subscription.</p>
  </div>
  <a href="/#waitlist" class="mt-4 md:mt-0 shrink-0 font-semibold text-brand-700 underline underline-offset-4 hover:text-brand-900">Join the waitlist<span class="sr-only"> for the one-off report</span> →</a>
</div>
)}
