<script>
  // Small progressive-enhancement layer: reveals, count-ups, sliding tabs, hero demo. No libraries, no tracking.
  const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    const el = e.target as HTMLElement; el.classList.add('in'); io.unobserve(el);
    el.querySelectorAll<HTMLElement>('[data-to]').forEach(countUp);
    el.dispatchEvent(new CustomEvent('af:in'));
  }), { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll<HTMLElement>('.rv, .cov-anim').forEach((el) => { if (el.dataset.d) el.style.transitionDelay = el.dataset.d + 'ms'; io.observe(el); });
  function countUp(el: HTMLElement) {
    const to = Number(el.dataset.to); if (RM || !to) return;
    let t0 = 0; const step = (n: number) => { t0 ||= n; const k = Math.min(1, (n - t0) / 1100); el.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(step); };
    requestAnimationFrame(step);
  }
  // Tabs (WAI-ARIA tabs pattern, automatic activation). Without JS the tablist stays hidden and all panels show.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const list = root.querySelector<HTMLElement>('[role=tablist]')!; const pill = list.querySelector<HTMLElement>('.seg-pill')!;
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
    const select = (i: number, focus = false, anim = true) => {
      tabs.forEach((t, j) => { const on = i === j; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; panels[j].hidden = !on; if (on && anim && !RM) { panels[j].classList.remove('tabpanel-in'); void panels[j].offsetWidth; panels[j].classList.add('tabpanel-in'); } });
      pill.style.width = tabs[i].offsetWidth + 'px'; pill.style.transform = `translateX(${tabs[i].offsetLeft}px)`;
      if (focus) tabs[i].focus();
    };
    list.hidden = false;
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const k = e.key; let n = -1;
        if (k === 'ArrowRight') n = (i + 1) % tabs.length; else if (k === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length; else if (k === 'Home') n = 0; else if (k === 'End') n = tabs.length - 1;
        if (n >= 0) { e.preventDefault(); select(n, true); }
      });
    });
    select(0, false, false);
    addEventListener('resize', () => select(tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true'), false, false));
  });
  // Hero sequence (one time, never loops). The HTML is the final state; JS rewinds to step A only when motion is allowed.
  const fig = document.querySelector<HTMLElement>('.hero-fig');
  if (fig && !RM) {
    const ring = fig.querySelector<HTMLElement>('.score-ring')!, num = fig.querySelector<HTMLElement>('[data-score]')!;
    fig.dataset.seq = 'a'; ring.style.setProperty('--p', '70'); num.textContent = '70';
    const seq = new IntersectionObserver((es) => {
      if (!es.some((e) => e.isIntersecting)) return; seq.disconnect();
      setTimeout(() => { fig.dataset.seq = 'b'; }, 1200);
      setTimeout(() => {
        fig.dataset.seq = 'c'; ring.style.setProperty('--p', '82');
        let t0 = 0; const step = (n: number) => { t0 ||= n; const k = Math.min(1, (n - t0) / 800); num.textContent = String(Math.round(70 + 12 * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(step); };
        requestAnimationFrame(step);
      }, 2400);
    }, { threshold: 0.15 });
    seq.observe(fig);
  }
  // Tilt / spotlight: loaded on idle; tilt.js itself attaches nothing on touch or reduced motion.
  if (document.querySelector('[data-tilt],[data-spotlight]')) {
    const load = () => import('../lib/tilt.js');
    'requestIdleCallback' in window ? requestIdleCallback(load, { timeout: 2000 }) : setTimeout(load, 1200);
  }
</script>
