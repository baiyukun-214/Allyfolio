---
import { i18n, basePath, localize, dict } from '../i18n';
interface Props { class?: string; hasTranslation?: boolean }
const { class: cls = '', hasTranslation = true } = Astro.props;
const { other } = i18n(Astro.url.pathname);
const target = hasTranslation ? localize(basePath(Astro.url.pathname), other) : localize('/', other);
const s = dict(other === 'en' ? 'zh-CN' : 'en').switcher; // labels describe the *other* language
---
<a href={target} hreflang={other} lang={other} aria-label={s.aria} class={`inline-flex items-center gap-1.5 ${cls}`}>
  <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 21a9 9 0 100-18 9 9 0 000 18zM3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg>
  <span>{s.label}</span>
</a>
