---
interface Props { items?: { q: string; a: string }[] }
const faqs = Astro.props.items ?? [
  { q: 'Does Allyfolio make my website meet the EAA?', a: 'No tool can do that on its own. Allyfolio finds the issues automated testing can detect, tracks them over time and keeps a timestamped record of your progress. Automated testing catches roughly 57% of accessibility issues (Deque study); the rest needs manual review by people. We help you plan that review, we do not replace it.' },
  { q: 'Is this an overlay widget?', a: 'No. Allyfolio never injects scripts into your site. Overlays try to patch problems in the visitor\'s browser and are widely criticised by disabled users and accessibility experts. We help you fix the actual code.' },
  { q: 'Does the EAA apply to my business?', a: 'The European Accessibility Act has applied since 28 June 2025 to many consumer-facing products and services, including e-commerce, banking and e-books. Microenterprises providing services – fewer than 10 staff and an annual turnover or balance sheet of no more than €2 million – are exempt from the service requirements. Check your situation with a legal adviser.' },
  { q: 'What is the BFSG?', a: 'The Barrierefreiheitsstärkungsgesetz is Germany\'s national law implementing the EAA. It also applies from 28 June 2025.' },
  { q: 'What do you test with?', a: 'Real browsers driven by Playwright, running the open-source axe-core engine against the pages you choose, on a schedule you set.' },
  { q: 'Is Allyfolio legal advice?', a: 'No. Allyfolio is a testing and documentation tool. Draft accessibility statements are a starting point for you to review and adapt.' },
];
---
<div class="divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
  {faqs.map((f) => (
    <details class="group px-6">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 font-semibold text-ink hover:text-brand-700">
        {f.q}
        <svg aria-hidden="true" class="h-5 w-5 shrink-0 text-brand-500 transition-transform group-open:rotate-45" viewBox="0 0 20 20" fill="currentColor"><path d="M9 4h2v12H9z"/><path d="M4 9h12v2H4z"/></svg>
      </summary>
      <p class="pb-5 -mt-1 text-muted leading-relaxed max-w-3xl">{f.a}</p>
    </details>
  ))}
</div>
