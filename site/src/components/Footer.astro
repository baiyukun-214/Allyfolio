---
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import { appLink } from '../lib/api';
import { i18n } from '../i18n';
interface Props { hasTranslation?: boolean }
const { lang, t, l } = i18n(Astro.url.pathname);
const year = new Date().getFullYear();
const link = 'text-muted hover:text-brand-700 hover:underline underline-offset-4';
---
<footer class="border-t border-slate-200 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-12 grid gap-10 sm:grid-cols-2 md:grid-cols-[2fr_1fr_1fr_1fr] text-sm">
    <div class="max-w-xs">
      <p class="flex items-center gap-2 font-semibold text-ink text-base"><Logo size={24} />Allyfolio</p>
      <p class="mt-3 text-muted">{t.footer.tagline}</p>
      <p class="mt-3"><a class="text-brand-700 underline underline-offset-4" href="mailto:hello@allyfolio.com">hello@allyfolio.com</a></p>
    </div>
    <nav aria-label={t.footer.product}>
      <h2 class="font-semibold text-ink">{t.footer.product}</h2>
      <ul class="mt-3 space-y-2">
        <li><a class={link} href={l('/pricing')}>{t.nav.pricing}</a></li>
        <li><a class={link} href={l('/free-scan')}>{t.nav.freeScan}</a></li>
        <li><a class={link} href={l('/blog')}>{t.nav.blog}</a></li>
        <li><a class={link} href={l('/about')}>{t.nav.about}</a></li>
      </ul>
    </nav>
    <nav aria-label={t.nav.account}>
      <h2 class="font-semibold text-ink">{t.nav.account}</h2>
      <ul class="mt-3 space-y-2">
        <li data-auth="out"><a class={link} href={appLink('/login', lang)}>{t.nav.login}</a></li>
        <li data-auth="out"><a class={link} href={appLink('/signup', lang)}>{t.nav.signup}</a></li>
        <li data-auth="in" hidden><a class={link} href={appLink('/app', lang)}>{t.nav.dashboard}</a></li>
        <li><LangSwitch class={link} hasTranslation={Astro.props.hasTranslation} /></li>
      </ul>
    </nav>
    <nav aria-label={t.footer.legal}>
      <h2 class="font-semibold text-ink">{t.footer.legal}</h2>
      <ul class="mt-3 space-y-2">
        <li><a class={link} href={l('/privacy')}>{t.footer.privacy}</a></li>
        <li><a class={link} href={l('/terms')}>{t.footer.terms}</a></li>
        <li><a class={link} href={l('/dpa')}>{t.footer.dpa}</a></li>
        <li><a class={link} href={l('/imprint')}>{t.footer.imprint}</a></li>
        <li><a class={link} href={l('/accessibility-statement')}>{t.footer.statement}</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-slate-200">
    <p class="mx-auto max-w-6xl px-4 py-5 text-xs text-muted">&copy; {year} Allyfolio. {t.footer.copyright}</p>
  </div>
</footer>
