---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
const link = 'text-muted hover:text-brand-700 hover:underline underline-offset-4';
---
<footer class="border-t border-slate-200 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-12 grid gap-10 sm:grid-cols-2 md:grid-cols-[2fr_1fr_1fr] text-sm">
    <div class="max-w-xs">
      <p class="flex items-center gap-2 font-semibold text-ink text-base"><Logo size={24} />Allyfolio</p>
      <p class="mt-3 text-muted">Accessibility monitoring and evidence for EU websites. No overlay widgets.</p>
      <p class="mt-3"><a class="text-brand-700 underline underline-offset-4" href="mailto:hello@allyfolio.com">hello@allyfolio.com</a></p>
    </div>
    <nav aria-label="Product">
      <h2 class="font-semibold text-ink">Product</h2>
      <ul class="mt-3 space-y-2">
        <li><a class={link} href="/pricing">Pricing</a></li>
        <li><a class={link} href="/free-scan">Free scan</a></li>
        <li><a class={link} href="/blog">Blog</a></li>
        <li><a class={link} href="/about">About</a></li>
      </ul>
    </nav>
    <nav aria-label="Legal">
      <h2 class="font-semibold text-ink">Legal</h2>
      <ul class="mt-3 space-y-2">
        <li><a class={link} href="/privacy">Privacy policy</a></li>
        <li><a class={link} href="/imprint">Imprint</a></li>
        <li><a class={link} href="/accessibility-statement">Accessibility statement</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-slate-200">
    <p class="mx-auto max-w-6xl px-4 py-5 text-xs text-muted">&copy; {year} Allyfolio. A testing and documentation tool, not legal advice.</p>
  </div>
</footer>
