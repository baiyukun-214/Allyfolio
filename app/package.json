{
  "name": "allyfolio-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/unit/*.test.ts",
    "test:e2e": "tsx --test test/e2e/*.test.ts",
    "test:a11y": "tsx scripts/axe-dashboard.ts",
    "set-plan": "tsx scripts/set-plan.ts",
    "paddle:setup": "tsx scripts/paddle-setup.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/formbody": "^9.0.1",
    "@fastify/static": "^10.1.6",
    "@fontsource-variable/inter": "^5.3.0",
    "fastify": "^5.12.7",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
