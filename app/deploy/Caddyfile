# app.allyfolio.com = dashboard + API (/api/scan is called cross-origin by the marketing site; CORS via SITE_ORIGINS).
# Certificates: Let's Encrypt via HTTP-01/TLS-ALPN. Port 80 and 443 must reach this server.
app.allyfolio.com {
	encode zstd gzip
	reverse_proxy app:8787
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

