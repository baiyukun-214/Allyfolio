# app.allyfolio.com = dashboard + API (/api/scan is called cross-origin by the marketing site; CORS via SITE_ORIGINS).
# Certificates: Let's Encrypt via HTTP-01/TLS-ALPN. Port 80 and 443 must reach this server.
app.allyfolio.com {
	encode zstd gzip
	reverse_proxy app:8787
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# Access log (JSON) for Paddle / bot review diagnosis. Lives on the caddydata volume (/data).
	# Cookie / Authorization / Set-Cookie stripped so sessions and credentials are not stored.
	log {
		output file /data/logs/access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			wrap json
			delete request>headers>Cookie
			delete request>headers>cookie
			delete request>headers>Authorization
			delete request>headers>authorization
			delete resp_headers>Set-Cookie
			delete resp_headers>set-cookie
		}
	}
}

# Optional: serve the marketing site from this server too (normally it is on Cloudflare Workers).
# Only uncomment if allyfolio.com/www DNS points at this server, otherwise Caddy keeps failing certificate issuance.
