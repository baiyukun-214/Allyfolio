# ---- Server ----
PORT=8787
PUBLIC_APP_URL=http://localhost:8787    # public URL of the dashboard/API (links in emails, Paddle return URLs). Prod: https://app.allyfolio.com
SITE_URL=http://localhost:4321          # marketing site; dashboard links back to it (/zh for Chinese). Prod: https://allyfolio.com
SITE_ORIGINS=http://localhost:4321      # comma-separated marketing-site origins allowed by CORS
COOKIE_DOMAIN=                          # prod: .allyfolio.com (shares the non-secret af_logged_in hint cookie with the site); empty on localhost
DATABASE_PATH=./data/allyfolio.db
SESSION_SECRET=change-me-to-32-random-bytes
LOG_LEVEL=info

# ---- Scanning ----
SCAN_TIMEOUT_MS=30000
SCAN_CONCURRENCY=2
FREE_SCAN_PER_IP_PER_HOUR=5
ALLOW_PRIVATE_TARGETS=0                 # NEVER 1 in production; only for local tests
SCAN_PROXY=                             # egress proxy for Chromium; docker-compose sets http://egress:3128

# ---- Mail: console | resend (default: resend when RESEND_API_KEY is set) ----
MAILER=console
MAIL_FROM="Allyfolio <hello@allyfolio.com>"
RESEND_API_KEY=re_xxx                   # domain allyfolio.com added in Resend with region eu-west-1 (Ireland)

# ---- Billing: paddle | creem (stub) | none ----
BILLING_PROVIDER=paddle
PADDLE_ENV=sandbox                      # sandbox | production
PADDLE_API_KEY=pdl_sdbx_apikey_xxx
PADDLE_WEBHOOK_SECRET=                  # optional locally (return-URL sync); required in production
PADDLE_CLIENT_TOKEN=test_xxx            # client-side token for Paddle.js (public by design)
# --- written by `npm run paddle:setup` (IDs only; the webhook secret only when PADDLE_WEBHOOK_URL is set) ---
PADDLE_PRICE_STARTER=pri_xxx
PADDLE_PRICE_BUSINESS=pri_xxx
PADDLE_PRICE_AGENCY=pri_xxx
PADDLE_PRICE_ONEOFF=pri_xxx             # €49 one-off report
PADDLE_DISCOUNT_EARLYBIRD=dsc_xxx
PADDLE_NOTIFICATION_SETTING_ID=
PADDLE_WEBHOOK_URL=                     # public https URL for paddle:setup to register, e.g. https://<name>.trycloudflare.com/api/billing/webhook
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=

# ---- Error monitoring (optional; Sentry or GlitchTip DSN). Empty = off ----
SENTRY_DSN=
APP_RELEASE=

# ---- Backups (docker-compose "backup" service) ----
BACKUP_TIME=03:15                       # daily, UTC
BACKUP_KEEP_DAILY=14
BACKUP_RCLONE_REMOTE=                   # optional offsite, e.g. storagebox:allyfolio-backups (deploy/rclone/rclone.conf)
BACKUP_REMOTE_KEEP_DAYS=30
