# Server
PORT=8787
APP_URL=http://localhost:8787           # public URL of the dashboard/API
SITE_ORIGINS=http://localhost:4321      # comma-separated marketing-site origins allowed by CORS
DATABASE_PATH=./data/allyfolio.db
SESSION_SECRET=change-me-to-32-random-bytes
# Scanning
SCAN_TIMEOUT_MS=30000
SCAN_CONCURRENCY=2
FREE_SCAN_PER_IP_PER_HOUR=5
ALLOW_PRIVATE_TARGETS=0                 # NEVER 1 in production; only for local tests
# Mail: console | smtp
MAILER=console
MAIL_FROM="Allyfolio <hello@allyfolio.com>"
SMTP_URL=
# Stripe (TEST mode keys). Run `npm run stripe:setup` to create prices + coupon and print the IDs.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx
STRIPE_PRICE_AGENCY=price_xxx
STRIPE_PRICE_ONEOFF=price_xxx
STRIPE_COUPON_EARLYBIRD=coupon_xxx

# Marketing site URL (dashboard links back to it; /zh for Chinese)
SITE_URL=http://localhost:4321
# Shared parent domain for the af_logged_in hint cookie in production, e.g. .allyfolio.com (leave empty on localhost)
COOKIE_DOMAIN=
